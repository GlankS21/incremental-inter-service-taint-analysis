+    /** vkr patch (ADR-TCI-3): a checksum of the bytes and relative paths of every file below
+     * {@code file}; when it is a file, of its bytes and name. */
+    private static long contentHash(File file) {
+        CRC32 crc = new CRC32();
+        try {
+            if (file.isFile()) {
+                crc.update(file.getName().getBytes(StandardCharsets.UTF_8));
+                crc.update(Long.toString(file.length()).getBytes(StandardCharsets.UTF_8));
+                try (InputStream in = new BufferedInputStream(new FileInputStream(file))) {
+                    for (int n; (n = in.read(BUFFER)) > 0; ) {
+                        crc.update(BUFFER, 0, n);
+                    }
+                }
+                return crc.getValue();
+            }
+            List<File> files = new ArrayList<>();
+            Deque<File> stack = new ArrayDeque<>();
+            stack.push(file);
+            while (!stack.isEmpty()) {
+                File dir = stack.pop();
+                File[] children = dir.listFiles();
+                if (children != null) {
+                    for (File child : children) {
+                        if (child.isDirectory()) {
+                            stack.push(child);
+                        } else {
+                            files.add(child);
+                        }
+                    }
+                }
+            }
+            files.sort(Comparator.comparing(File::getPath));
+            for (File f : files) {
+                crc.update(f.getPath().getBytes(StandardCharsets.UTF_8));
+                crc.update(Long.toString(f.length()).getBytes(StandardCharsets.UTF_8));
+                try (InputStream in = new BufferedInputStream(new FileInputStream(f))) {
+                    for (int n; (n = in.read(BUFFER)) > 0; ) {
+                        crc.update(BUFFER, 0, n);
+                    }
+                }
+            }
+        } catch (IOException e) {
+            return 0;
+        }
+        return crc.getValue();
+    }
